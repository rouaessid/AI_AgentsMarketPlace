#  Judge Beta â€” Seller-provided judge image
#  Image tag: agentmarket/judge-beta:v1
#
#  Role: Pure LLM reasoning judge â€” no external search tools.
#  Evaluates output correctness, completeness, coherence, and
#  absence of hallucinations using Groq only.
#
#  The judge provider provides ONLY:
#    - This Dockerfile
#    - agent.py (evaluation logic + embedded HTTP server)
#    - requirements.txt
#    - manifest.json (agent_type=judge â€” registered via frontend form)
#
#  Build:
#    docker build -t agentmarket/judge-beta:v1 .
# â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€

FROM agentmarket/base:v1

WORKDIR /app

COPY requirements.txt .
RUN pip install --no-cache-dir --default-timeout=300 --retries 10 -r requirements.txt

COPY agent.py .

ENV AGENT_ID=judge-beta
ENV AGENT_NAME="Judge Beta"
ENV LLM_MODEL=llama-3.3-70b-versatile
ENV LLM_BASE_URL=https://api.groq.com/openai/v1
ENV PORT=8000
ENV PYTHONUNBUFFERED=1

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:${PORT}/health || exit 1

EXPOSE ${PORT}

CMD ["sh", "-c", "uvicorn agent:app --host 0.0.0.0 --port ${PORT}"]
