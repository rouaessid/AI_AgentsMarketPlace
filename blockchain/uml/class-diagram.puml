@startuml AgentMarket_SmartContracts
' ═══════════════════════════════════════════════════════════════
'  Diagramme de classes UML — Smart Contracts AgentMarket
'  Conventions :
'    <<contract>>  contrat Solidity
'    <<interface>> interface Solidity
'    <<struct>>    structure de données Solidity
'    <<enum>>      énumération Solidity
'    +  public / external
'    -  private
'    #  internal
'    {field}       variable d'état
'    {method}      fonction
' ═══════════════════════════════════════════════════════════════

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam stereotypeCBackgroundColor #E8F5E9
skinparam stereotypeIBackgroundColor #E3F2FD
skinparam classBackgroundColor #FFFDE7
skinparam classBorderColor #555
skinparam classHeaderBackgroundColor #FFF8E1
skinparam arrowColor #333333
skinparam arrowThickness 1.5
skinparam linetype ortho
hide empty members

' ═══════════════════════════════════════════════════════════════
'  OpenZeppelin (contracts externes)
' ═══════════════════════════════════════════════════════════════
package "OpenZeppelin" <<Frame>> #F5F5F5 {
  class ERC721URIStorage <<contract>> {
    + tokenURI(tokenId : uint256) : string
    # _setTokenURI(tokenId : uint256, uri : string)
    # _update(to : address, tokenId : uint256, auth : address) : address
  }
  class Ownable <<contract>> {
    + owner() : address
    + transferOwnership(newOwner : address)
    + renounceOwnership()
  }
  class EIP712 <<contract>> {
    # _hashTypedDataV4(structHash : bytes32) : bytes32
    + DOMAIN_SEPARATOR() : bytes32
  }
  class ReentrancyGuard <<contract>> {
    ' guard against reentrancy
  }
  interface IERC721 <<interface>> {
    + ownerOf(tokenId : uint256) : address
    + approve(to : address, tokenId : uint256)
    + setApprovalForAll(operator : address, approved : bool)
    + transferFrom(from : address, to : address, tokenId : uint256)
  }
  ERC721URIStorage ..|> IERC721
}

' ═══════════════════════════════════════════════════════════════
'  ÉNUMÉRATIONS
' ═══════════════════════════════════════════════════════════════
enum AgentType <<enum>> {
  PROVIDER
  JUDGE
}

enum AgentStatus <<enum>> {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum TaskStatus <<enum>> {
  PENDING
  COMMITTING
  REVEALING
  FINALISED
  EXPIRED
}

enum InternalVote <<enum>> {
  NONE
  VALID
  INVALID
}

' ═══════════════════════════════════════════════════════════════
'  STRUCTS — IdentityRegistry
' ═══════════════════════════════════════════════════════════════
class AgentVersion <<struct>> {
  + tokenId : uint256
  + agentURI : string
  + version : string
  + mintedAt : uint256
  + isCurrent : bool
}

class AgentIdentity <<struct>> {
  + agentId : string
  + agentType : AgentType
  + status : AgentStatus
  + owner : address
  + agentWallet : address
  + createdAt : uint256
  + currentTokenId : uint256
  + tokenHistory : uint256[]
  + pricePerTask : uint256
}

' ═══════════════════════════════════════════════════════════════
'  STRUCTS — ReputationRegistry
' ═══════════════════════════════════════════════════════════════
class FeedbackData <<struct>> {
  + value : int128
  + valueDecimals : uint8
  + tag1 : string
  + tag2 : string
  + isRevoked : bool
}

' ═══════════════════════════════════════════════════════════════
'  STRUCTS — StakingContract
' ═══════════════════════════════════════════════════════════════
class StakeInfo <<struct>> {
  + amount : uint256
  + lockedUntil : uint256
  + exists : bool
}

' ═══════════════════════════════════════════════════════════════
'  STRUCTS — ValidationRegistry
' ═══════════════════════════════════════════════════════════════
class JudgeCommit <<struct>> {
  + commitHash : bytes32
  + vote : InternalVote
  + taskCompletion : uint8
  + outputQuality : uint8
  + noFabrication : uint8
  + toolUsage : uint8
  + committed : bool
  + revealed : bool
}

class ValidationTask <<struct>> {
  + taskId : string
  + providerAgentId : string
  + providerWallet : address
  + requestHash : bytes32
  + traceHash : bytes32
  + erc8004AgentId : uint256
  + status : TaskStatus
  + createdAt : uint256
  + commitDeadline : uint256
  + revealDeadline : uint256
  + judgeIds : string[3]
  + judgeWallets : address[3]
  + finalResponse : uint8
  + finalTag : string
  + score : uint256
  + mode : uint8
}

class ValidationRecord <<struct>> {
  + validatorAddress : address
  + agentId : uint256
  + response : uint8
  + responseHash : bytes32
  + tag : string
  + responseURI : string
  + lastUpdate : uint256
}

' ═══════════════════════════════════════════════════════════════
'  INTERFACES
' ═══════════════════════════════════════════════════════════════
interface IIdentityRegistry <<interface>> {
  + agentIdExists(agentId_ : string) : bool
  + getCurrentTokenId(agentId_ : string) : uint256
  + ownerOf(tokenId : uint256) : address
  + isActive(agentId : string) : bool
  + getAgentWallet(agentId : string) : address
  + getAgentType(agentId : string) : uint8
  + getPricePerTask(agentId_ : string) : uint256
}

interface IStakingContract <<interface>> {
  + isEligibleProvider(agent : address) : bool
  + isEligibleJudge(agent : address) : bool
  + isLocked(agent : address) : bool
  + lockStake(agent : address, duration : uint256)
  + unlockStake(agent : address)
  + slashProvider(agent : address) : uint256
  + slashJudge(agent : address) : uint256
}

interface IReputationRegistry <<interface>> {
  + recordFromValidation(agentId : string, taskId : string, score : uint8)
  + recordReputation(agentId : string, delta : uint256, isIncrease : bool, reason : string)
}

interface IEscrowManager <<interface>> {
  + releaseFunds(taskId : string, provider : address, consensusJudges : address[])
  + releaseFundsPipeline(taskId : string, consensusJudges : address[])
  + refundClient(taskId : string)
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — IdentityRegistry
' ═══════════════════════════════════════════════════════════════
class IdentityRegistry <<contract>> {
  ' ── Variables d'état ──────────────────────────────
  + {field} agentRegistry : string
  - {field} _nextTokenId : uint256
  - {field} _agents : mapping(string => AgentIdentity)
  - {field} _tokenToAgentId : mapping(uint256 => string)
  - {field} _versions : mapping(uint256 => AgentVersion)
  - {field} _agentIdExists : mapping(string => bool)
  - {field} _metadata : mapping(uint256 => mapping(string => bytes))
  ' ── Fonctions ─────────────────────────────────────
  + {method} register(agentId_ : string, agentType_ : AgentType, agentURI_ : string, version_ : string, pricePerTask_ : uint256) : uint256
  + {method} mintNewVersion(agentId_ : string, newURI_ : string, newVersion_ : string) : uint256
  + {method} setAgentStatus(agentId_ : string, newStatus : AgentStatus)
  + {method} setMetadata(tokenId : uint256, key : string, value : bytes)
  + {method} setAgentWallet(agentId_ : string, newWallet : address, deadline : uint256, signature : bytes)
  + {method} setPricePerTask(agentId_ : string, newPrice_ : uint256)
  + {method} getAgent(agentId_ : string) : AgentIdentity
  + {method} getAgentType(agentId_ : string) : uint8
  + {method} getVersion(tokenId : uint256) : AgentVersion
  + {method} getCurrentTokenId(agentId_ : string) : uint256
  + {method} getTokenHistory(agentId_ : string) : uint256[]
  + {method} getAgentIdByToken(tokenId : uint256) : string
  + {method} getAgentWallet(agentId_ : string) : address
  + {method} getPricePerTask(agentId_ : string) : uint256
  + {method} getMetadata(tokenId : uint256, key : string) : bytes
  + {method} isActive(agentId_ : string) : bool
  + {method} agentIdExists(agentId_ : string) : bool
  + {method} totalTokensMinted() : uint256
  + {method} agentURI(agentId_ : string) : string
  # {method} _update(to : address, tokenId : uint256, auth : address) : address
  # {method} _exists(tokenId : uint256) : bool
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — ReputationRegistry
' ═══════════════════════════════════════════════════════════════
class ReputationRegistry <<contract>> {
  ' ── Variables d'état ──────────────────────────────
  + {field} identityRegistry : IIdentityRegistry
  + {field} authorizedCallers : mapping(address => bool)
  - {field} _feedback : mapping(uint256 => mapping(address => mapping(uint64 => FeedbackData)))
  - {field} _lastIndex : mapping(uint256 => mapping(address => uint64))
  - {field} _clients : mapping(uint256 => address[])
  - {field} _isClient : mapping(uint256 => mapping(address => bool))
  ' ── Fonctions ─────────────────────────────────────
  + {method} initialize(identityRegistry_ : address)
  + {method} setAuthorizedCaller(caller : address, authorized : bool)
  + {method} giveFeedback(agentId : uint256, value : int128, valueDecimals : uint8, tag1 : string, tag2 : string, endpoint : string, feedbackURI : string, feedbackHash : bytes32)
  + {method} recordFromValidation(agentId : string, taskId : string, score : uint8)
  + {method} recordReputation(agentId : string, delta : uint256, isIncrease : bool, reason : string)
  + {method} revokeFeedback(agentId : uint256, feedbackIndex : uint64)
  + {method} appendResponse(agentId : uint256, clientAddress : address, feedbackIndex : uint64, responseURI : string, responseHash : bytes32)
  + {method} getIdentityRegistry() : address
  + {method} getSummary(agentId : uint256, clientAddresses : address[], tag1Filter : string, tag2Filter : string) : (uint64, int128, uint8)
  + {method} readFeedback(agentId : uint256, clientAddress : address, feedbackIndex : uint64) : (int128, uint8, string, string, bool)
  + {method} readAllFeedback(agentId : uint256, clientAddresses : address[], tag1Filter : string, tag2Filter : string, includeRevoked : bool) : tuples[]
  + {method} getClients(agentId : uint256) : address[]
  + {method} getLastIndex(agentId : uint256, clientAddress : address) : uint64
  - {method} _requireRegistry()
  - {method} _store(agentId : uint256, clientAddress : address, value : int128, ...)
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — EscrowManager
' ═══════════════════════════════════════════════════════════════
class EscrowManager <<contract>> {
  ' ── Variables d'état ──────────────────────────────
  + {field} validationRegistry : address
  + {field} identityRegistry : address
  + {field} judgeFeePercentage : uint256
  + {field} taskFunds : mapping(string => uint256)
  + {field} taskClients : mapping(string => address)
  + {field} taskAgent : mapping(string => string)
  + {field} isPipelineTask : mapping(string => bool)
  - {field} _pipelineWallets : mapping(string => address[])
  - {field} _pipelineShares : mapping(string => uint256[])
  ' ── Fonctions ─────────────────────────────────────
  + {method} setValidationRegistry(_registry : address)
  + {method} setIdentityRegistry(_registry : address)
  + {method} setJudgeFeePercentage(_percentage : uint256)
  + {method} depositPayment(taskId_ : string, agentId_ : string) <<payable>>
  + {method} releaseFunds(taskId_ : string, provider_ : address, consensusJudges_ : address[])
  + {method} refundClient(taskId_ : string)
  + {method} depositPaymentPipeline(taskId_ : string, agentIds_ : string[], wallets_ : address[], shares_bps_ : uint256[]) <<payable>>
  + {method} releaseFundsPipeline(taskId_ : string, consensusJudges_ : address[])
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — StakingContract
' ═══════════════════════════════════════════════════════════════
class StakingContract <<contract>> {
  ' ── Constantes ────────────────────────────────────
  + {field} MIN_PROVIDER_STAKE : uint256 = 0.001 ether
  + {field} MIN_JUDGE_STAKE : uint256 = 0.0005 ether
  + {field} SLASH_PROVIDER_BPS : uint256 = 1000
  + {field} SLASH_JUDGE_BPS : uint256 = 500
  ' ── Variables d'état ──────────────────────────────
  + {field} validationRegistry : address
  + {field} platformWallet : address
  + {field} stakes : mapping(address => StakeInfo)
  ' ── Fonctions ─────────────────────────────────────
  + {method} setValidationRegistry(_registry : address)
  + {method} setPlatformWallet(_wallet : address)
  + {method} stake() <<payable>>
  + {method} withdraw()
  + {method} lockStake(agent : address, duration : uint256)
  + {method} unlockStake(agent : address)
  + {method} slashProvider(agent : address) : uint256
  + {method} slashJudge(agent : address) : uint256
  + {method} getStake(agent : address) : uint256
  + {method} isEligibleProvider(agent : address) : bool
  + {method} isEligibleJudge(agent : address) : bool
  + {method} isLocked(agent : address) : bool
  - {method} _slash(agent : address, bps : uint256, reason : string) : uint256
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — ValidationRegistry
' ═══════════════════════════════════════════════════════════════
class ValidationRegistry <<contract>> {
  ' ── Constantes ────────────────────────────────────
  + {field} JUDGE_COUNT : uint8 = 3
  + {field} COMMIT_WINDOW : uint256 = 5 min
  + {field} REVEAL_WINDOW : uint256 = 5 min
  + {field} STAKE_LOCK_DURATION : uint256 = 15 min
  + {field} MAX_CANDIDATES : uint256 = 20
  + {field} RESPONSE_VALID : uint8 = 100
  + {field} RESPONSE_INVALID : uint8 = 0
  + {field} RESPONSE_DISPUTED : uint8 = 50
  + {field} REP_JUDGE_CONSENSUS : uint256 = 5
  + {field} REP_JUDGE_DEVIATED : uint256 = 8
  + {field} REP_JUDGE_ABSENT : uint256 = 10
  ' ── Variables d'état ──────────────────────────────
  + {field} identityRegistry : IIdentityRegistry
  + {field} stakingContract : IStakingContract
  + {field} reputationRegistry : IReputationRegistry
  + {field} escrowManager : IEscrowManager
  + {field} _agentTotalScore : mapping(string => uint256)
  + {field} _agentScoreCount : mapping(string => uint256)
  + {field} judgeAgreements : mapping(address => uint256)
  + {field} judgeTotalVotes : mapping(address => uint256)
  + {field} judgeOnboarded : mapping(string => bool)
  + {field} judgeFlagged : mapping(string => bool)
  + {field} judgeHoneypotFails : mapping(string => uint256)
  - {field} _tasks : mapping(string => ValidationTask)
  - {field} _taskExists : mapping(string => bool)
  - {field} _commits : mapping(string => mapping(string => JudgeCommit))
  - {field} _judgeActiveTask : mapping(string => string)
  - {field} _validationRecords : mapping(bytes32 => ValidationRecord)
  - {field} _agentValidations : mapping(uint256 => bytes32[])
  - {field} _validatorRequests : mapping(address => bytes32[])
  ' ── Fonctions admin ───────────────────────────────
  + {method} setIdentityRegistry(a : address)
  + {method} setStakingContract(a : address)
  + {method} setReputationRegistry(a : address)
  + {method} setEscrowManager(a : address)
  + {method} recordHoneypotResult(judgeId_ : string, passed_ : bool, resultCID_ : string)
  + {method} setJudgeOnboarded(judgeId_ : string)
  + {method} isJudgeAuthorized(judgeId_ : string) : bool
  ' ── Flux de validation ────────────────────────────
  + {method} validationRequest(taskId_ : string, providerAgentId_ : string, requestURI_ : string, requestHash_ : bytes32, traceHash_ : bytes32, mode_ : uint8)
  + {method} assignJudges(taskId_ : string, candidates_ : string[])
  + {method} commitVote(taskId_ : string, judgeId_ : string, commitHash_ : bytes32)
  + {method} revealVote(taskId_ : string, judgeId_ : string, vote_ : InternalVote, salt_ : bytes32, taskCompletion_ : uint8, outputQuality_ : uint8, noFabrication_ : uint8, toolUsage_ : uint8)
  + {method} finaliseValidation(taskId_ : string, justificationURI_ : string)
  + {method} expireTask(taskId_ : string)
  + {method} recordPipelineScores(agentIds_ : string[], taskId_ : string, scores_ : uint8[])
  ' ── Vues ERC-8004 ─────────────────────────────────
  + {method} getValidationStatus(requestHash : bytes32) : (address, uint256, uint8, bytes32, string, uint256)
  + {method} getSummary(agentId_ : uint256, validatorAddresses : address[], tag_ : string) : (uint64, uint8)
  + {method} getAgentValidations(agentId_ : uint256) : bytes32[]
  + {method} getValidatorRequests(validatorAddress : address) : bytes32[]
  ' ── Vues internes ─────────────────────────────────
  + {method} getTask(taskId_ : string) : ValidationTask
  + {method} getResponseURI(taskId_ : string) : string
  + {method} getTraceHash(taskId_ : string) : bytes32
  + {method} getJudgeCommit(taskId_ : string, judgeId_ : string) : JudgeCommit
  + {method} isJudgeBusy(judgeId_ : string) : bool
  + {method} getJudgeActiveTask(judgeId_ : string) : string
  + {method} getAgentScore(agentId_ : string) : (uint256, uint256)
  + {method} getJudgeAgreementRate(judgeWallet_ : address) : (uint256, uint256)
  + {method} isEligibleJudgeCandidate(judgeId_ : string) : bool
  - {method} _getTask(taskId_ : string) : ValidationTask
  - {method} _judgeIndexOf(t : ValidationTask, judgeId_ : string) : uint256
  - {method} _allCommitted(t : ValidationTask) : bool
  - {method} _allRevealed(t : ValidationTask) : bool
  - {method} _isEligibleJudge(judgeId_ : string) : bool
  - {method} _recordValidationResponse(requestHash_ : bytes32, agentId_ : uint256, response_ : uint8, responseURI_ : string, tag_ : string)
  - {method} _applyOutcomes(t : ValidationTask, providerValid : bool, votedValid : bool[3], didReveal : bool[3])
}

' ═══════════════════════════════════════════════════════════════
'  HÉRITAGE (--|>)
' ═══════════════════════════════════════════════════════════════
IdentityRegistry   --|> ERC721URIStorage : extends
IdentityRegistry   --|> Ownable          : extends
IdentityRegistry   --|> EIP712           : extends
ReputationRegistry --|> Ownable          : extends
EscrowManager      --|> Ownable          : extends
EscrowManager      --|> ReentrancyGuard  : extends
StakingContract    --|> Ownable          : extends
StakingContract    --|> ReentrancyGuard  : extends
ValidationRegistry --|> Ownable          : extends
ValidationRegistry --|> ReentrancyGuard  : extends

' ═══════════════════════════════════════════════════════════════
'  RÉALISATION d'interfaces (..|>)
' ═══════════════════════════════════════════════════════════════
IdentityRegistry   ..|> IIdentityRegistry   : realizes
StakingContract    ..|> IStakingContract    : realizes
ReputationRegistry ..|> IReputationRegistry : realizes
EscrowManager      ..|> IEscrowManager      : realizes

' ═══════════════════════════════════════════════════════════════
'  DÉPENDANCES — uses (-->)
' ═══════════════════════════════════════════════════════════════
ValidationRegistry --> IIdentityRegistry   : uses
ValidationRegistry --> IStakingContract    : uses
ValidationRegistry --> IReputationRegistry : uses
ValidationRegistry --> IEscrowManager      : uses
ReputationRegistry --> IIdentityRegistry   : uses
EscrowManager      --> IIdentityRegistry   : uses

' ═══════════════════════════════════════════════════════════════
'  COMPOSITION — structs contenues dans leurs contrats (*--)
' ═══════════════════════════════════════════════════════════════
IdentityRegistry   *-- AgentVersion     : contains
IdentityRegistry   *-- AgentIdentity    : contains
ReputationRegistry *-- FeedbackData     : contains
StakingContract    *-- StakeInfo        : contains
ValidationRegistry *-- JudgeCommit      : contains
ValidationRegistry *-- ValidationTask   : contains
ValidationRegistry *-- ValidationRecord : contains

' ═══════════════════════════════════════════════════════════════
'  ASSOCIATIONS — enums utilisés dans les structs (o--)
' ═══════════════════════════════════════════════════════════════
AgentIdentity  o-- AgentType   : agentType
AgentIdentity  o-- AgentStatus : status
JudgeCommit    o-- InternalVote : vote
ValidationTask o-- TaskStatus  : status

@enduml
