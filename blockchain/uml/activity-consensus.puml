@startuml
title Consensus

skinparam backgroundColor white
skinparam defaultFontSize 10
skinparam ArrowThickness 1

start

:collecter les votes des 3 juges;

if (votes VALID >= 2 ?) then (oui)
  :verdict VALID;
else (non)
  :verdict INVALID;
  :penaliser Agent Executeur;
endif

:recompenser les juges alignes avec Consensus;
:penaliser les juges deviants ou absents;

stop

@enduml
