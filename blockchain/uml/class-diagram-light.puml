@startuml AgentMarket_SmartContracts_Light
' ═══════════════════════════════════════════════════════════════
'  Diagramme de classes UML — Smart Contracts AgentMarket
'  UML pur : si le type est une classe du diagramme → relation,
'             pas attribut (pas de doublon)
'  Conventions :
'    Map<K,V>  = mapping Solidity (notation UML générique)
'    T[]       = tableau dynamique
'    +  public/external   -  private   #  internal
' ═══════════════════════════════════════════════════════════════

skinparam classAttributeIconSize 0
skinparam classFontStyle Bold
skinparam classBackgroundColor #FFFDE7
skinparam classBorderColor #555
skinparam classHeaderBackgroundColor #FFE082
skinparam stereotypeCBackgroundColor #C8E6C9
skinparam stereotypeIBackgroundColor #BBDEFB
skinparam arrowColor #333
skinparam arrowThickness 1.5
skinparam linetype ortho
skinparam nodesep 60
skinparam ranksep 80
hide empty members

' ═══════════════════════════════════════════════════════════════
'  OpenZeppelin
' ═══════════════════════════════════════════════════════════════
package "OpenZeppelin" <<Frame>> #F5F5F5 {
  class ERC721URIStorage <<contract>>
  class Ownable <<contract>>
  class EIP712 <<contract>>
  class ReentrancyGuard <<contract>>
  interface IERC721 <<interface>> {
    + ownerOf(tokenId : uint256) : address
    + transferFrom(from, to : address, tokenId : uint256)
  }
  ERC721URIStorage ..|> IERC721
}

' ═══════════════════════════════════════════════════════════════
'  ÉNUMÉRATIONS
' ═══════════════════════════════════════════════════════════════
enum AgentType <<enum>> {
  PROVIDER
  JUDGE
}

enum AgentStatus <<enum>> {
  ACTIVE
  SUSPENDED
  REVOKED
}

enum TaskStatus <<enum>> {
  PENDING
  COMMITTING
  REVEALING
  FINALISED
  EXPIRED
}

enum InternalVote <<enum>> {
  NONE
  VALID
  INVALID
}

' ═══════════════════════════════════════════════════════════════
'  STRUCTS
'  Règle : les champs dont le type est un enum du diagramme
'           sont supprimés → montrés par association o--
' ═══════════════════════════════════════════════════════════════
class AgentVersion <<struct>> {
  + tokenId : uint256
  + agentURI : string
  + version : string
  + mintedAt : uint256
  + isCurrent : bool
}

class AgentIdentity <<struct>> {
  ' agentType et status → voir associations o--
  + agentId : string
  + owner : address
  + agentWallet : address
  + createdAt : uint256
  + currentTokenId : uint256
  + tokenHistory : uint256[]
  + pricePerTask : uint256
}

class FeedbackData <<struct>> {
  + value : int128
  + valueDecimals : uint8
  + tag1 : string
  + tag2 : string
  + isRevoked : bool
}

class StakeInfo <<struct>> {
  + amount : uint256
  + lockedUntil : uint256
  + exists : bool
}

class JudgeCommit <<struct>> {
  ' vote → voir association o--
  + commitHash : bytes32
  + taskCompletion : uint8
  + outputQuality : uint8
  + noFabrication : uint8
  + toolUsage : uint8
  + committed : bool
  + revealed : bool
}

class ValidationTask <<struct>> {
  ' status → voir association o--
  + taskId : string
  + providerAgentId : string
  + providerWallet : address
  + requestHash : bytes32
  + traceHash : bytes32
  + erc8004AgentId : uint256
  + createdAt : uint256
  + commitDeadline : uint256
  + revealDeadline : uint256
  + judgeIds : string[3]
  + judgeWallets : address[3]
  + finalResponse : uint8
  + finalTag : string
  + score : uint256
  + mode : uint8
}

class ValidationRecord <<struct>> {
  + validatorAddress : address
  + agentId : uint256
  + response : uint8
  + responseHash : bytes32
  + tag : string
  + responseURI : string
  + lastUpdate : uint256
}

' ═══════════════════════════════════════════════════════════════
'  INTERFACES
' ═══════════════════════════════════════════════════════════════
interface IIdentityRegistry <<interface>> {
  + isActive(agentId : string) : bool
  + agentIdExists(agentId : string) : bool
  + getAgentWallet(agentId : string) : address
  + getAgentType(agentId : string) : uint8
  + getCurrentTokenId(agentId : string) : uint256
  + getPricePerTask(agentId : string) : uint256
  + ownerOf(tokenId : uint256) : address
}

interface IStakingContract <<interface>> {
  + isEligibleProvider(agent : address) : bool
  + isEligibleJudge(agent : address) : bool
  + isLocked(agent : address) : bool
  + lockStake(agent : address, duration : uint256)
  + unlockStake(agent : address)
  + slashProvider(agent : address) : uint256
  + slashJudge(agent : address) : uint256
}

interface IReputationRegistry <<interface>> {
  + recordFromValidation(agentId : string, taskId : string, score : uint8)
  + recordReputation(agentId : string, delta : uint256, isIncrease : bool, reason : string)
}

interface IEscrowManager <<interface>> {
  + releaseFunds(taskId : string, provider : address, judges : address[])
  + releaseFundsPipeline(taskId : string, judges : address[])
  + refundClient(taskId : string)
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — IdentityRegistry
'  _agents   → composition *-- AgentIdentity
'  _versions → composition *-- AgentVersion
' ═══════════════════════════════════════════════════════════════
class IdentityRegistry <<contract>> {
  ' ── Variables d'état (types primitifs uniquement) ─
  + agentRegistry : string
  - _nextTokenId : uint256
  - _metadata : Map<uint256, Map<string, bytes>>
  ' ── Méthodes essentielles ─────────────────────────
  + register(agentId, agentType, agentURI, version, pricePerTask) : uint256
  + mintNewVersion(agentId, newURI, newVersion) : uint256
  + setAgentStatus(agentId, newStatus : AgentStatus)
  + setAgentWallet(agentId, newWallet, deadline, signature)
  + setPricePerTask(agentId, newPrice)
  + setMetadata(tokenId, key, value)
  + getAgent(agentId) : AgentIdentity
  + isActive(agentId) : bool
  + agentIdExists(agentId) : bool
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — ReputationRegistry
'  identityRegistry → uses IIdentityRegistry
'  _feedback        → composition *-- FeedbackData
' ═══════════════════════════════════════════════════════════════
class ReputationRegistry <<contract>> {
  ' ── Variables d'état (types primitifs uniquement) ─
  + authorizedCallers : Map<address, bool>
  - _lastIndex : Map<uint256, Map<address, uint64>>
  - _clients : Map<uint256, address[]>
  ' ── Méthodes essentielles ─────────────────────────
  + initialize(identityRegistry_ : address)
  + setAuthorizedCaller(caller : address, authorized : bool)
  + giveFeedback(agentId, value, valueDecimals, tag1, tag2, endpoint, feedbackURI, feedbackHash)
  + recordFromValidation(agentId, taskId, score : uint8)
  + recordReputation(agentId, delta, isIncrease, reason)
  + revokeFeedback(agentId, feedbackIndex)
  + getSummary(agentId, clientAddresses[], tag1Filter, tag2Filter) : (count, value, decimals)
  + readFeedback(agentId, clientAddress, feedbackIndex) : FeedbackData
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — EscrowManager
'  identityRegistry stocké comme address (primitif) → gardé
' ═══════════════════════════════════════════════════════════════
class EscrowManager <<contract>> {
  ' ── Variables d'état ──────────────────────────────
  + validationRegistry : address
  + identityRegistry : address
  + judgeFeePercentage : uint256
  + taskFunds : Map<string, uint256>
  + taskClients : Map<string, address>
  + taskAgent : Map<string, string>
  + isPipelineTask : Map<string, bool>
  - _pipelineWallets : Map<string, address[]>
  - _pipelineShares : Map<string, uint256[]>
  ' ── Méthodes essentielles ─────────────────────────
  + depositPayment(taskId, agentId) <<payable>>
  + depositPaymentPipeline(taskId, agentIds[], wallets[], shares_bps[]) <<payable>>
  + releaseFunds(taskId, provider, consensusJudges[])
  + releaseFundsPipeline(taskId, consensusJudges[])
  + refundClient(taskId)
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — StakingContract
'  stakes → composition *-- StakeInfo
' ═══════════════════════════════════════════════════════════════
class StakingContract <<contract>> {
  ' ── Variables d'état (types primitifs uniquement) ─
  + validationRegistry : address
  + platformWallet : address
  ' ── Méthodes essentielles ─────────────────────────
  + stake() <<payable>>
  + withdraw()
  + lockStake(agent, duration)
  + unlockStake(agent)
  + slashProvider(agent) : uint256
  + slashJudge(agent) : uint256
  + isEligibleProvider(agent) : bool
  + isEligibleJudge(agent) : bool
  + isLocked(agent) : bool
}

' ═══════════════════════════════════════════════════════════════
'  CONTRACT — ValidationRegistry
'  identityRegistry, stakingContract,
'  reputationRegistry, escrowManager → uses (interfaces)
'  _tasks, _commits, _validationRecords → compositions *--
' ═══════════════════════════════════════════════════════════════
class ValidationRegistry <<contract>> {
  ' ── Variables d'état (types primitifs uniquement) ─
  + _agentTotalScore : Map<string, uint256>
  + _agentScoreCount : Map<string, uint256>
  + judgeAgreements : Map<address, uint256>
  + judgeTotalVotes : Map<address, uint256>
  + judgeOnboarded : Map<string, bool>
  + judgeFlagged : Map<string, bool>
  + judgeHoneypotFails : Map<string, uint256>
  - _agentValidations : Map<uint256, bytes32[]>
  - _validatorRequests : Map<address, bytes32[]>
  ' ── Flux de validation ────────────────────────────
  + validationRequest(taskId, providerAgentId, requestURI, requestHash, traceHash, mode)
  + assignJudges(taskId, candidates[])
  + commitVote(taskId, judgeId, commitHash)
  + revealVote(taskId, judgeId, vote, salt, taskCompletion, outputQuality, noFabrication, toolUsage)
  + finaliseValidation(taskId, justificationURI)
  + expireTask(taskId)
  ' ── Honeypot ──────────────────────────────────────
  + recordHoneypotResult(judgeId, passed, resultCID)
  + setJudgeOnboarded(judgeId)
  + isJudgeAuthorized(judgeId) : bool
  ' ── Vues ──────────────────────────────────────────
  + getTask(taskId) : ValidationTask
  + getAgentScore(agentId) : (avgScore, totalTasks)
  + getValidationStatus(requestHash) : ValidationRecord
}

' ═══════════════════════════════════════════════════════════════
'  HÉRITAGE
' ═══════════════════════════════════════════════════════════════
IdentityRegistry   --|> ERC721URIStorage
IdentityRegistry   --|> Ownable
IdentityRegistry   --|> EIP712
ReputationRegistry --|> Ownable
EscrowManager      --|> Ownable
EscrowManager      --|> ReentrancyGuard
StakingContract    --|> Ownable
StakingContract    --|> ReentrancyGuard
ValidationRegistry --|> Ownable
ValidationRegistry --|> ReentrancyGuard

' ═══════════════════════════════════════════════════════════════
'  RÉALISATION d'interfaces
' ═══════════════════════════════════════════════════════════════
IdentityRegistry   ..|> IIdentityRegistry
StakingContract    ..|> IStakingContract
ReputationRegistry ..|> IReputationRegistry
EscrowManager      ..|> IEscrowManager

' ═══════════════════════════════════════════════════════════════
'  DÉPENDANCES — uses
'  (remplace les attributs de type interface dans les contrats)
' ═══════════════════════════════════════════════════════════════
ValidationRegistry ..> IIdentityRegistry   : uses
ValidationRegistry ..> IStakingContract    : uses
ValidationRegistry ..> IReputationRegistry : uses
ValidationRegistry ..> IEscrowManager      : uses
ReputationRegistry ..> IIdentityRegistry   : uses
EscrowManager      ..> IIdentityRegistry   : uses

' ═══════════════════════════════════════════════════════════════
'  COMPOSITION — structs dans leurs contrats
'  (remplace les attributs Map<K, StructType> dans les contrats)
' ═══════════════════════════════════════════════════════════════
IdentityRegistry   "1" *-- "0..*" AgentVersion
IdentityRegistry   "1" *-- "0..*" AgentIdentity
ReputationRegistry "1" *-- "0..*" FeedbackData
StakingContract    "1" *-- "0..*" StakeInfo
ValidationRegistry "1" *-- "0..*" JudgeCommit
ValidationRegistry "1" *-- "0..*" ValidationTask
ValidationRegistry "1" *-- "0..*" ValidationRecord

' ═══════════════════════════════════════════════════════════════
'  ASSOCIATIONS — enums dans les structs
'  (remplace les champs de type enum dans les structs)
' ═══════════════════════════════════════════════════════════════
AgentIdentity  o-- AgentType    : agentType
AgentIdentity  o-- AgentStatus  : status
JudgeCommit    o-- InternalVote : vote
ValidationTask o-- TaskStatus   : status

@enduml
